// Tractoflow (scilpy 2.2.2 port) on Alliance Rorqual.
// Nextflow runs inside a SLURM allocation with the local executor
// (compute nodes have no internet access).

singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = "--no-home -B /project -B /scratch -B /home"

process.scratch = true

// Hard links: no extra space, results survive work/ cleanup
process.publishDir = [path: {"$params.output_dir/$sid/$task.process"}, mode: 'link']
