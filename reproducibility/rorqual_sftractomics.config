// sf-tractomics on Alliance Rorqual: local executor inside a SLURM allocation.
// Images are pre-pulled on a login node (setup_login_node.sh) into
// NXF_APPTAINER_CACHEDIR, compute nodes have no internet access.

executor {
    name   = 'local'
    cpus   = System.getenv('SLURM_CPUS_PER_TASK') as int
    memory = '115 GB'
}

process.resourceLimits = [
    cpus  : System.getenv('SLURM_CPUS_PER_TASK') as int,
    memory: 115.GB,
    time  : 72.h
]

apptainer.runOptions = '--no-home -B /project -B /scratch -B /home'
